# Copy to .env for local development (`task dev` loads it). Never commit .env.
APP_ENV=development
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080
LOG_LEVEL=debug

DATABASE_URL=postgres://rentmap:rentmap@localhost:5432/rentmap?sslmode=disable
# Empty scratch DB for `task db:diff` (created by deploy/docker/db-init).
DEV_DATABASE_URL=postgres://rentmap:rentmap@localhost:5432/rentmap_diff?sslmode=disable

MIGRATE_ON_BOOT=true
STATIC_FROM_DISK=true
TRUST_PROXY=false

# Auth. Generate a real secret outside dev: openssl rand -base64 48
AUTH_SECRET=dev-only-insecure-auth-secret-change-me
SESSION_TTL=720h
SMS_DAILY_CAP=2000

# SMS: log | mailpit | africastalking
#   mailpit        → each SMS lands in the Mailpit inbox at http://localhost:8025
#   africastalking → set AT_USERNAME=sandbox + AT_API_KEY from the AT sandbox app,
#                    then watch https://simulator.africastalking.com
SMS_PROVIDER=mailpit
SMS_SENDER_ID=RentMap
MAILPIT_SMTP_ADDR=localhost:1025
MAILPIT_WEB_URL=http://localhost:8025
AT_USERNAME=
AT_API_KEY=
AT_SANDBOX=true

# Private uploads (ID evidence is AES-256-GCM encrypted with DOCUMENT_KEY).
# Dev falls back to a derived key; set a real one elsewhere: openssl rand -base64 32
STORAGE_DIR=./data/private
DOCUMENT_KEY=
EVIDENCE_RETENTION=2160h

# Listing photos (public). disk = MEDIA_DIR; s3 = any S3-compatible bucket.
# Dev runs SeaweedFS on :8333 with these credentials (deploy/seaweedfs/s3.json).
MEDIA_STORE=s3
MEDIA_DIR=./data/media
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=rentmap-media
S3_ACCESS_KEY_ID=rentmap
S3_SECRET_ACCESS_KEY=rentmap-dev-secret
S3_PATH_STYLE=true

# Seeds the fixed offset of public map points. Set once, never rotate.
LOCATION_SECRET=dev-only-location-secret
