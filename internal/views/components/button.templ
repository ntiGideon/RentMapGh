package components

type Variant string

const (
	Primary     Variant = "primary"     // Graphite (light) / Sky Mint (dark)
	Accent      Variant = "accent"      // Sky Mint + Graphite text
	Ghost       Variant = "ghost"       // outlined
	OnDark      Variant = "ondark"      // Sky Mint on a Graphite band, both themes
	Destructive Variant = "destructive" // final, irreversible step (delete account)
	DangerSoft  Variant = "dangersoft"  // negative but reversible-looking choice (reject)
)

type Size string

const (
	SM Size = "sm"
	MD Size = "md" // ≥44 px touch target
	LG Size = "lg"
)

func buttonClass(v Variant, s Size, full bool) string {
	c := "group/btn relative inline-flex select-none items-center justify-center gap-1.5 whitespace-nowrap rounded-lg font-medium " +
		"transition-[background-color,border-color,box-shadow,transform] duration-150 ease-out active:translate-y-px " +
		"focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus " +
		"disabled:pointer-events-none disabled:opacity-60 "
	switch s {
	case SM:
		c += "h-8 px-3 text-sm "
	case LG:
		c += "h-12 px-5 text-base "
	default:
		c += "h-11 px-4 text-base "
	}
	switch v {
	case Accent, OnDark:
		c += "bg-mint-200 text-graphite-900 shadow-xs hover:bg-mint-100 "
	case DangerSoft:
		c += "border border-red-600/25 bg-red-50 text-red-700 shadow-xs hover:border-red-600/40 hover:bg-red-100 dark:border-red-400/25 dark:bg-red-400/10 dark:text-red-300 dark:hover:bg-red-400/15 "
	case Destructive:
		c += "bg-red-600 text-white shadow-btn hover:bg-red-700 dark:bg-red-500 dark:hover:bg-red-600 "
	case Ghost:
		c += "border border-line bg-surface-raised text-fg shadow-xs hover:border-line-strong hover:bg-surface "
	default:
		c += "bg-primary text-on-primary shadow-btn hover:bg-primary-hover "
	}
	if full {
		c += "w-full "
	}
	return c
}

type ButtonProps struct {
	Variant Variant
	Size    Size
	Type    string // "button" (default) | "submit"
	Full    bool
	Attrs   templ.Attributes
}

// Button shows a spinner while its htmx request is in flight.
templ Button(p ButtonProps) {
	<button type={ orDefault(p.Type, "button") } class={ buttonClass(p.Variant, p.Size, p.Full) } { p.Attrs... }>
		<span class="inline-flex items-center gap-2 transition-opacity group-[.htmx-request]/btn:opacity-0">
			{ children... }
		</span>
		<span class="htmx-indicator absolute inset-0 flex items-center justify-center" aria-hidden="true">
			@Icon("loader", "size-4 animate-spin")
		</span>
	</button>
}

templ LinkButton(href string, v Variant, s Size) {
	<a href={ templ.SafeURL(href) } class={ buttonClass(v, s, false) }>
		{ children... }
	</a>
}

func orDefault(s, d string) string {
	if s == "" {
		return d
	}
	return s
}
