package layouts

import (
	"strconv"
	"time"

	"rentmapgh/internal/server/reqctx"
	c "rentmapgh/internal/views/components"
)

type navLink struct{ href, label string }

var siteNav = []navLink{
	{"/search", "Find a place"},
	{"/#why", "Why RentMap"},
	{"/#how", "How it works"},
	{"/#listers", "For landlords"},
}

// Site is the public marketing shell: header, main, footer.
templ Site(m Meta) {
	@Base(m) {
		<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-lg supports-[backdrop-filter]:bg-bg/70">
			<div class="mx-auto flex h-14 max-w-6xl items-center gap-8 px-4 sm:px-6">
				<a href="/" class="-m-1 rounded-md p-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" aria-label="RentMap Ghana home">
					@c.Logo()
				</a>
				<nav class="hidden md:block" aria-label="Main">
					<ul class="flex items-center gap-1">
						for _, l := range siteNav {
							<li>
								<a href={ templ.SafeURL(l.href) } class="rounded-md px-2.5 py-1.5 text-sm font-medium text-fg-muted transition-colors hover:text-fg">{ l.label }</a>
							</li>
						}
					</ul>
				</nav>
				<div class="ml-auto flex items-center gap-1.5">
					@ThemeToggle()
					if v := reqctx.CurrentViewer(ctx); v != nil {
						if v.HasAny("landlord", "agent") {
							<a href="/listings" class="hidden h-8 items-center rounded-lg px-2.5 text-sm font-medium text-fg-muted transition-colors hover:bg-surface hover:text-fg sm:inline-flex">Your listings</a>
						}
						if v.HasAny("moderator", "admin") {
							<a href="/admin" class="hidden h-8 items-center rounded-lg px-2.5 text-sm font-medium text-fg-muted transition-colors hover:bg-surface hover:text-fg sm:inline-flex">Admin</a>
						}
						<a href="/account" class="flex h-8 items-center gap-2 rounded-lg py-1 pl-1 pr-2.5 text-sm font-medium text-fg transition-colors hover:bg-surface" aria-label="Your account">
							<span class="grid size-6 place-items-center rounded-full bg-mint-200 text-xs font-semibold text-graphite-900">{ v.Initial() }</span>
							<span class="hidden sm:inline">Account</span>
						</a>
					} else {
						<a href="/login" class="inline-flex h-8 items-center rounded-lg px-2.5 text-sm font-medium text-fg-muted transition-colors hover:bg-surface hover:text-fg">Sign in</a>
						<a href="/#join" class="hidden h-8 items-center gap-1 rounded-lg bg-primary px-3 text-sm font-medium text-on-primary shadow-btn transition-colors hover:bg-primary-hover sm:inline-flex">
							Join the waitlist
						</a>
					}
				</div>
			</div>
		</header>
		<main id="main">
			{ children... }
		</main>
		@footer()
	}
}

templ ThemeToggle() {
	<button type="button" data-theme-toggle aria-pressed="false" aria-label="Toggle dark mode" class="grid size-8 place-items-center rounded-lg text-fg-muted transition-colors hover:bg-surface hover:text-fg focus-visible:outline-2 focus-visible:outline-focus">
		@c.Icon("moon", "size-4 dark:hidden")
		@c.Icon("sun", "hidden size-4 dark:block")
	</button>
}

templ footer() {
	<footer class="border-t border-line">
		<div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.5fr_1fr_1fr]">
			<div class="space-y-3">
				@c.Logo()
				<p class="max-w-xs text-sm text-fg-muted">Honest rentals, on a map. Built in Kumasi for students and workers around KNUST.</p>
			</div>
			<div>
				<h2 class="text-xs font-medium text-fg-subtle">Product</h2>
				<ul class="mt-3 space-y-2 text-sm">
					for _, l := range siteNav {
						<li><a href={ templ.SafeURL(l.href) } class="text-fg-muted transition-colors hover:text-fg">{ l.label }</a></li>
					}
				</ul>
			</div>
			<div>
				<h2 class="text-xs font-medium text-fg-subtle">Preferences</h2>
				<ul class="mt-3 space-y-2 text-sm">
					<li>
						<button type="button" data-saver-toggle class="inline-flex items-center gap-1.5 text-fg-muted transition-colors hover:text-fg">
							@c.Icon("signal", "size-3.5")
							if reqctx.DataSaver(ctx) {
								Data saver: on
							} else {
								Data saver: off
							}
						</button>
					</li>
					<li>
						<button type="button" data-theme-toggle class="inline-flex items-center gap-1.5 text-fg-muted transition-colors hover:text-fg">
							@c.Icon("moon", "size-3.5 dark:hidden")
							@c.Icon("sun", "hidden size-3.5 dark:block")
							Switch theme
						</button>
					</li>
				</ul>
			</div>
		</div>
		<div class="border-t border-line">
			<div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-fg-subtle sm:flex-row sm:items-center sm:justify-between sm:px-6">
				<p>© { strconv.Itoa(time.Now().Year()) } RentMap Ghana. All rights reserved.</p>
				<p>Made in Kumasi, Ghana</p>
			</div>
		</div>
	</footer>
}
