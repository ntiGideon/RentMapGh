package partials

import (
	"strconv"

	c "rentmapgh/internal/views/components"
)

// MandateView is the "Owner authority" card an agent sees on the review
// step. State is a mandates.State ("", pending, approved, declined,
// revoked, cancelled, expired).
type MandateView struct {
	ListingID    string
	State        string
	LandlordName string // as the agent typed it
	LandlordTel  string // masked, "020 ••• 2222"
	Sent         string // "2 h ago"
	ValidUntil   string // "27 March 2027"
	CanResend    bool
	Months       []int
	// form (a new request)
	FormName, FormPhone string
	FormMonths          int
	Errors              map[string]string
}

func (v MandateView) base() string { return "/listings/" + v.ListingID + "/owner" }

func (v MandateView) err(k string) string { return v.Errors[k] }

func (v MandateView) who() string {
	if v.LandlordName != "" {
		return v.LandlordName
	}
	return "The owner"
}

// AuthorityBadge labels an agent listing: confirmed by the owner or not.
templ AuthorityBadge(state string) {
	switch state {
		case "approved":
			@c.Badge(c.Success) {
				@c.Icon("check", "size-3")
				Owner confirmed
			}
		case "pending":
			@c.Badge(c.Warning) {
				Owner asked
			}
		default:
			@c.Badge(c.Neutral) {
				Owner not confirmed
			}
	}
}

templ OwnerAuthority(v MandateView) {
	<section id="owner-authority" aria-labelledby="owner-heading" class="rounded-card border border-line bg-surface-raised p-5 shadow-xs">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<h2 id="owner-heading" class="text-base font-semibold text-fg">Owner authority</h2>
			@AuthorityBadge(v.State)
		</div>
		if msg := v.err("form"); msg != "" {
			<div class="mt-3 flex items-center gap-2 rounded-lg border border-red-600/15 bg-red-50 px-3 py-2.5 text-sm text-danger dark:bg-red-400/10 dark:text-red-300" role="alert">
				@c.Icon("alert", "size-3.5")
				{ msg }
			</div>
		}
		switch v.State {
			case "approved":
				<p class="mt-2 text-sm text-fg-muted">
					{ v.who() } ({ v.LandlordTel }) approved you to list this property until { v.ValidUntil }. Renters see “Owner authority confirmed”.
				</p>
			case "pending":
				<p class="mt-2 text-sm text-fg-muted">
					We texted { v.who() } ({ v.LandlordTel }) { v.Sent }. Until they approve, renters see “owner authority not confirmed”. The link works for 14 days.
				</p>
				<div class="mt-3 flex flex-wrap justify-end gap-2">
					<form method="post" action={ templ.SafeURL(v.base() + "/cancel") }>
						@c.Button(c.ButtonProps{Type: "submit", Variant: c.Ghost, Size: c.SM}) {
							Cancel request
						}
					</form>
					if v.CanResend {
						<form method="post" action={ templ.SafeURL(v.base() + "/resend") }>
							@c.Button(c.ButtonProps{Type: "submit", Variant: c.Ghost, Size: c.SM}) {
								Send again
							}
						</form>
					}
				</div>
			default:
				<p class="mt-2 text-sm text-fg-muted">
					switch v.State {
						case "declined":
							{ v.who() } declined your last request.
						case "revoked":
							{ v.who() } withdrew their approval.
						case "expired":
							Your last request or approval has lapsed.
					}
					Ask the owner to confirm you may list this property. We text them a link to approve — no account needed. Without it, renters see “Agent listing — owner authority not confirmed”.
				</p>
				@ownerRequestForm(v)
		}
	</section>
}

templ ownerRequestForm(v MandateView) {
	<form method="post" action={ templ.SafeURL(v.base()) } class="mt-4 grid gap-4 sm:grid-cols-2">
		@c.Field(c.FieldProps{ID: "landlord_name", Name: "landlord_name", Label: "Owner's name", Value: v.FormName, Placeholder: "Mrs Owusu",
			Hint: "So they know it's about their property", Error: v.err("landlord_name"), Attrs: templ.Attributes{"maxlength": "80", "autocomplete": "off"}})
		@c.Field(c.FieldProps{ID: "landlord_phone", Name: "landlord_phone", Label: "Owner's phone", Type: "tel", Value: v.FormPhone, Placeholder: "024 123 4567",
			Required: true, Error: v.err("landlord_phone"), Attrs: templ.Attributes{"inputmode": "tel", "autocomplete": "off"}})
		<fieldset class="sm:col-span-2">
			<legend class="text-sm font-medium text-fg">Approval lasts</legend>
			<div class="mt-2 flex gap-2">
				for _, m := range v.Months {
					<label class="inline-flex h-9 cursor-pointer items-center rounded-lg border border-line px-3 text-sm text-fg has-checked:border-graphite-900 has-checked:bg-surface has-checked:font-medium dark:has-checked:border-mint-200">
						<input type="radio" name="months" value={ strconv.Itoa(m) } checked?={ m == v.FormMonths } class="sr-only"/>
						{ strconv.Itoa(m) } months
					</label>
				}
			</div>
		</fieldset>
		<div class="flex justify-end sm:col-span-2">
			@c.Button(c.ButtonProps{Type: "submit"}) {
				@c.Icon("message", "size-4")
				Text the owner
			}
		</div>
	</form>
}
