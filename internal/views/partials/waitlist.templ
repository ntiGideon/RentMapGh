package partials

import (
	"net/url"

	c "rentmapgh/internal/views/components"
)

// WaitlistForm is the view model for the sign-up form.
type WaitlistForm struct {
	Name    string
	Phone   string
	Role    string
	Area    string
	Consent bool
	Areas   []c.Option
	Errors  map[string]string
}

var roleChoices = []c.Choice{
	{Value: "renter", Label: "I need a place", Icon: "search"},
	{Value: "landlord", Label: "I own property", Icon: "home"},
	{Value: "agent", Label: "I'm an agent", Icon: "badge-check"},
}

templ WaitlistFormCard(f WaitlistForm) {
	<form
		id="waitlist-form"
		action="/waitlist"
		method="post"
		hx-post="/waitlist"
		hx-target="this"
		hx-swap="outerHTML"
		hx-disabled-elt="find button[type=submit]"
		novalidate
		class="space-y-4"
	>
		<!-- Honeypot: humans never see or fill this. -->
		<div class="hidden" aria-hidden="true">
			<label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"/></label>
		</div>
		if msg, ok := f.Errors["form"]; ok {
			<div class="flex items-start gap-2 rounded-lg border border-red-600/15 bg-red-50 p-3 text-sm text-danger dark:border-red-400/20 dark:bg-red-400/10 dark:text-red-300" role="alert">
				@c.Icon("alert", "mt-0.5 size-3.5")
				{ msg }
			</div>
		}
		@c.ChoiceGroup("role", "I'm joining because…", f.Role, roleChoices)
		@c.Field(c.FieldProps{
			ID: "wl-phone", Name: "phone", Label: "Phone number (WhatsApp or SMS)", Type: "tel", Value: f.Phone,
			Placeholder: "24 123 4567", Prefix: "+233", Required: true, Error: f.Errors["phone"],
			Attrs: templ.Attributes{"inputmode": "tel", "autocomplete": "tel-national", "maxlength": "16"},
		})
		<div class="grid gap-4 sm:grid-cols-2 sm:gap-3">
			@c.Field(c.FieldProps{
				ID: "wl-name", Name: "name", Label: "First name", Value: f.Name, Placeholder: "Ama",
				Error: f.Errors["name"], Attrs: templ.Attributes{"autocomplete": "given-name", "maxlength": "80"},
			})
			@c.Select(c.SelectProps{
				ID: "wl-area", Name: "area", Label: "Area", Value: f.Area,
				Options: f.Areas, Prompt: "Choose an area", Error: f.Errors["area"],
			})
		</div>
		@c.Checkbox("wl-consent", "consent", "RentMap can message me on WhatsApp or SMS about the launch. No spam — unsubscribe any time.", f.Errors["consent"], f.Consent)
		@c.Button(c.ButtonProps{Type: "submit", Size: c.MD, Full: true}) {
			Join the waitlist
			@c.Icon("arrow-right", "size-4 transition-transform group-hover/btn:translate-x-0.5")
		}
	</form>
}

type WaitlistDone struct {
	Name        string
	PhoneMasked string
	AreaLabel   string
	Already     bool
	ShareURL    string
}

func whatsappShare(shareURL string) templ.SafeURL {
	text := "I just joined the RentMap Ghana waitlist — find rooms around KNUST with the full move-in cost upfront. " + shareURL
	return templ.SafeURL("https://wa.me/?text=" + url.QueryEscape(text))
}

templ WaitlistSuccess(d WaitlistDone) {
	<div id="waitlist-form" class="animate-rise py-2 text-center" role="status">
		<div class="mx-auto mb-4 grid size-12 animate-pop place-items-center rounded-full bg-mint-200 text-graphite-900 ring-6 ring-mint-100 dark:ring-mint-200/10">
			@c.Icon("check", "size-6 stroke-[2.5]")
		</div>
		<h3 class="text-xl font-semibold text-fg">
			if d.Already {
				You're already on the list
			} else if d.Name != "" {
				Akwaaba, { d.Name }!
			} else {
				Akwaaba! You're in.
			}
		</h3>
		<p class="mx-auto mt-1.5 max-w-sm text-sm text-fg-muted">
			We'll message <span class="font-semibold text-fg">{ d.PhoneMasked }</span> as soon as RentMap opens
			if d.AreaLabel != "" {
				in <span class="font-semibold text-fg">{ d.AreaLabel }</span>.
			} else {
				near you.
			}
		</p>
		<div class="mt-6 rounded-lg border border-line bg-surface p-4 text-left">
			<p class="text-sm font-medium text-fg">Know someone hunting for a room?</p>
			<p class="mt-0.5 text-sm text-fg-muted">The more people join, the sooner we open in your area.</p>
			<a
				href={ whatsappShare(d.ShareURL) }
				target="_blank"
				rel="noopener"
				class="mt-3 inline-flex h-11 w-full items-center justify-center gap-2 rounded-lg bg-[#25D366] px-4 text-base font-medium text-graphite-950 shadow-xs transition hover:brightness-95"
			>
				@c.Icon("message", "size-4")
				Share on WhatsApp
			</a>
		</div>
	</div>
}
