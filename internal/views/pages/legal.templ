package pages

import (
	"rentmapgh/internal/server/reqctx"
	"rentmapgh/internal/views/layouts"
)

// DocView is a legal or help page. Contact is the support email ("" until
// the inbox exists: a placeholder shows instead).
type DocView struct {
	Contact string
	Updated string // "28 September 2026"
}

templ doc(m layouts.Meta, v DocView, title, lede string, legal bool) {
	@layouts.Site(m) {
		<article id="main" class="mx-auto max-w-3xl px-4 pb-24 pt-10 sm:px-6">
			<h1 class="text-3xl font-semibold tracking-tight text-fg">{ title }</h1>
			<p class="mt-3 text-lg text-fg-muted">{ lede }</p>
			<p class="mt-2 text-sm text-fg-subtle">Last updated { v.Updated }</p>
			if legal {
				<p class="mt-6 rounded-lg border border-amber-500/50 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:bg-amber-400/10 dark:text-amber-100" role="note">
					Draft for review. This page explains how RentMap works today; it will be checked by a Ghanaian lawyer before launch and may change.
				</p>
			}
			<div class="doc mt-8 text-fg [&_a]:font-medium [&_a]:text-link [&_a:hover]:underline [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h3]:mt-6 [&_h3]:font-semibold [&_li]:mt-2 [&_p]:mt-3 [&_p]:leading-relaxed [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5 [&_li]:leading-relaxed">
				{ children... }
			</div>
		</article>
	}
}

templ contact(v DocView) {
	if v.Contact != "" {
		<a href={ templ.SafeURL("mailto:" + v.Contact) }>{ v.Contact }</a>
	} else {
		<span class="rounded bg-surface px-1.5 py-0.5 text-sm text-fg-muted">support contact — to be added before launch</span>
	}
}

// ── How we verify ────────────────────────────────────────────────────────

templ HowWeVerify(m layouts.Meta, v DocView) {
	@doc(m, v, "How we verify", "What each badge on RentMap means, how we check it, and what it doesn't promise.", false) {
		<h2>“ID checked”</h2>
		<p>The landlord or agent sent us photos of both sides of their Ghana Card and a selfie. A member of our team compared them by hand: the face matches, the card looks genuine, and the name matches the account.</p>
		<p>Landlords with a checked ID publish straight away. Everyone else's listings wait for a moderator to review them first.</p>
		<p>We keep the card photos encrypted and only for as long as we need them: they are deleted 90 days after the decision. The card number is never shown to anyone.</p>
		<h2>“Licensed agent”</h2>
		<p>The agent gave us their licence number and we checked it against the Real Estate Agency Council register. If they sent a certificate, we checked that too.</p>
		<h2>“Owner confirmed”</h2>
		<p>An agent can only list a place with the owner's permission. We text the owner a link; the owner confirms (or says they don't know the agent) without needing an account. Listings where the owner says no, or hasn't confirmed, don't get the badge.</p>
		<h2>“Still available” and freshness</h2>
		<p>Listers are asked regularly to confirm a place is still free. A place that isn't confirmed for 14 days leaves search. If you find one that's already taken, tap “Already rented? Tell us” on the listing and we'll ask the lister.</p>
		<h2>Photos and location</h2>
		<ul>
			<li>We strip hidden data (like GPS) from every photo and look for the same photo on other listings.</li>
			<li>The pin you see is within about 150–400 m of the real place. The exact address is shared only after a lister confirms your viewing.</li>
			<li>Listings close together with matching photos are flagged for a moderator as possible copies.</li>
		</ul>
		<h2>Reliability badges</h2>
		<p>“Replies within a day”, “Reliable for viewings” and “As described” come from what renters actually experienced: how quickly the lister answered viewing requests, whether they turned up, and the feedback after viewings.</p>
		<h2>What a badge doesn't mean</h2>
		<p>Checks lower the risk; they don't remove it. A badge is not a guarantee about the building, the lease or the person. Always view the place in person before you pay, and read our <a href="/safety">safety tips</a>.</p>
	}
}

// ── Safety ───────────────────────────────────────────────────────────────

templ Safety(m layouts.Meta, v DocView) {
	@doc(m, v, "Safety tips", "Most people renting on RentMap are honest. These habits protect you from the few who aren't.", false) {
		<h2>Before you pay anything</h2>
		<ul>
			<li><strong>Never pay before you've seen the place</strong> — no “booking”, “commitment”, “form” or “holding” fees. Honest landlords don't need one to show you a room.</li>
			<li>Pay only once you've seen the room, met the owner or their confirmed agent, and agreed the terms in writing.</li>
			<li>Ask for a written tenancy agreement and a receipt for every payment. Check that the name matches the owner.</li>
			<li>Know the rules: the Rent Act, 1963 (Act 220) limits how much rent in advance a landlord may demand. The Rent Control Department can advise you if you're asked for more.</li>
		</ul>
		<h2>Keep the conversation on RentMap</h2>
		<ul>
			<li>Our messages warn you about common scam lines (“send it on MoMo first”, “many people are interested”) and keep a record if something goes wrong.</li>
			<li>Be careful if someone pushes you to WhatsApp or a phone call before a viewing is confirmed.</li>
			<li>The lister's phone number and the exact address appear once they confirm your viewing.</li>
		</ul>
		<h2>At the viewing</h2>
		<ul>
			<li>Go in daylight and take someone with you if you can. Tell a friend where you're going.</li>
			<li>Check the water, the meter (prepaid or shared?), the lock, and mobile signal.</li>
			<li>Ask who else lives in the compound and what the other fees are. The move-in total on the listing should match.</li>
		</ul>
		<h2>Warning signs</h2>
		<ul>
			<li>The price is far below other places nearby.</li>
			<li>The lister “is travelling” and can't show the room but will send the keys after payment.</li>
			<li>The photos appear on another listing with a different lister.</li>
			<li>Pressure: “today only”, “pay now before someone else does”.</li>
		</ul>
		<h2>If something's wrong</h2>
		<p>Use “Report” on the listing or the message. A moderator reviews every report. If you've lost money, report it to the police as well — keep your receipts and screenshots.</p>
		<p>
			Questions? Write to us:
			@contact(v)
		</p>
	}
}

// ── Community guidelines ─────────────────────────────────────────────────

templ Guidelines(m layouts.Meta, v DocView) {
	@doc(m, v, "Community guidelines", "RentMap works because listings are real and people treat each other well. These rules apply to everyone.", true) {
		<h2>Listings</h2>
		<ul>
			<li>List only places you own or have the owner's permission to rent out. Agents need the owner's confirmation.</li>
			<li>Photos must show the actual place, taken recently — no stock photos, no photos from other listings, no people, no phone numbers or watermarks on them.</li>
			<li>Show the full cost: rent, how many months in advance, and every other fee. Hidden fees are not allowed.</li>
			<li>Keep availability honest: confirm when asked, and mark the place rented as soon as it is.</li>
			<li>One listing per room or unit. Don't post the same place twice.</li>
		</ul>
		<h2>Messages and viewings</h2>
		<ul>
			<li>Never ask for money before a viewing. Booking, form or “commitment” fees before a renter has seen the place are not allowed.</li>
			<li>Don't use RentMap to advertise other services or to collect people's numbers.</li>
			<li>Turn up to viewings you've confirmed, or cancel early. No-shows are shown on your profile.</li>
			<li>Be respectful. Harassment, threats and hate speech are not allowed.</li>
		</ul>
		<h2>Fair treatment</h2>
		<p>Don't refuse or treat renters differently because of their ethnicity, religion, disability or where they come from. Genuine house rules (for example “students only” in a hostel, or “no pets”) are fine when stated on the listing.</p>
		<h2>What happens when rules are broken</h2>
		<ul>
			<li>Listings can be sent back for changes or taken down; we tell you why.</li>
			<li>Accounts can be suspended. Suspended accounts can't sign in and their listings are paused.</li>
			<li>Serious fraud may be reported to the police.</li>
		</ul>
		<p>
			If you think we got a decision wrong, tell us and we'll take another look:
			@contact(v)
		</p>
	}
}

// ── Terms ────────────────────────────────────────────────────────────────

templ Terms(m layouts.Meta, v DocView) {
	@doc(m, v, "Terms of use", "The agreement between you and RentMap when you use the website.", true) {
		<p>[Legal entity name, registration number and address to be added.] In these terms, “RentMap”, “we” and “us” mean RentMap Ghana. By creating an account or using RentMap you agree to these terms.</p>
		<h2>1. What RentMap is</h2>
		<p>RentMap is a place for renters to find rooms and homes, and for landlords and agents to advertise them. We are not a party to any tenancy, we don't own or manage the places listed, and we don't collect rent or deposits. Any agreement is between the renter and the landlord (or their agent).</p>
		<h2>2. Your account</h2>
		<ul>
			<li>You sign in with a Ghanaian mobile number and a one-time code. Keep your phone secure; you're responsible for what happens on your account.</li>
			<li>You must be at least 18, or have a parent or guardian's permission.</li>
			<li>Give accurate information. Landlords and agents who ask for a badge must send genuine documents.</li>
		</ul>
		<h2>3. Listing on RentMap</h2>
		<ul>
			<li>You must have the right to rent out each place you list, and the listing must be accurate and complete, including every fee.</li>
			<li>You give us permission to show your listing, photos and video on RentMap and in links shared from it (for example on WhatsApp), and to make smaller copies of them.</li>
			<li>We may review, send back, hide or remove listings that break these terms or our <a href="/guidelines">community guidelines</a>.</li>
		</ul>
		<h2>4. Using RentMap safely</h2>
		<p>We check some things (see <a href="/how-we-verify">how we verify</a>), but we can't check everything. View a place before paying and follow our <a href="/safety">safety tips</a>. Report anything suspicious.</p>
		<h2>5. Things you must not do</h2>
		<ul>
			<li>Post fake, misleading or duplicate listings, or ask for payment before a viewing.</li>
			<li>Harass, threaten or discriminate against other people.</li>
			<li>Scrape the site, try to find the exact location of places before a confirmed viewing, or interfere with how RentMap works.</li>
		</ul>
		<h2>6. Suspension and closing your account</h2>
		<p>We may suspend accounts that break these terms. You can delete your account at any time from your account page; our <a href="/privacy">privacy policy</a> explains what we keep.</p>
		<h2>7. Fees</h2>
		<p>RentMap is currently free for renters and listers. If we introduce paid features, we'll tell you the price before you pay and these terms will be updated.</p>
		<h2>8. Liability</h2>
		<p>We provide RentMap “as is”. To the extent the law allows, we aren't responsible for losses arising from agreements between renters and listers, from inaccurate listings, or from the site being unavailable. Nothing in these terms limits rights you have under Ghanaian law that can't be limited.</p>
		<h2>9. Changes</h2>
		<p>We may update these terms. If a change is important we'll tell you on the site or by SMS before it applies.</p>
		<h2>10. Law and contact</h2>
		<p>
			These terms are governed by the laws of the Republic of Ghana. Questions:
			@contact(v)
		</p>
	}
}

// ── Privacy ──────────────────────────────────────────────────────────────

templ Privacy(m layouts.Meta, v DocView) {
	@doc(m, v, "Privacy policy", "What we collect, why, who sees it, and your rights under Ghana's Data Protection Act, 2012 (Act 843).", true) {
		<p>[Legal entity name, address and Data Protection Commission registration number to be added.] RentMap is the data controller for the personal data described here.</p>
		<h2>What we collect</h2>
		<ul>
			<li><strong>Account:</strong> your phone number, name, optional profile photo, the roles you choose (renter, landlord, agent), and your settings.</li>
			<li><strong>Verification (landlords and agents who ask for a badge):</strong> Ghana Card photos, a selfie, card and licence numbers.</li>
			<li><strong>Listings:</strong> the property's exact location, details, prices, photos and video.</li>
			<li><strong>Activity:</strong> saved places, messages, viewing requests and feedback, reports, and notifications.</li>
			<li><strong>Technical:</strong> signed-in devices (browser and IP address), sign-in history, and page views counted once a day per visitor (for listers' statistics).</li>
		</ul>
		<h2>Why we use it</h2>
		<ul>
			<li>To run your account, sign you in and send the texts you ask for (codes, viewing confirmations and reminders).</li>
			<li>To keep RentMap safe: checking identities, reviewing listings, spotting scams and duplicate listings, and handling reports.</li>
			<li>To show listers how their listings perform (in totals, never who viewed them).</li>
			<li>To improve RentMap using overall statistics.</li>
		</ul>
		<p>We don't sell your data and we don't show third-party ads.</p>
		<h2>Who can see what</h2>
		<ul>
			<li>Everyone: listings (with an approximate location), listers' names and badges.</li>
			<li>The other person in a conversation or viewing: your name and messages. A lister's phone number and the exact address are shared with a renter only after a viewing is confirmed.</li>
			<li>Our team: what they need for support and safety. Staff actions are recorded in an audit log. Support can view the site as you (read-only) to help with a problem; each time is recorded.</li>
			<li>Service providers who process data for us: our hosting provider, SMS delivery (Africa's Talking) and error monitoring. They may only use it to provide their service.</li>
			<li>Authorities, when the law requires it.</li>
		</ul>
		<h2>How long we keep it</h2>
		<ul>
			<li>Verification photos: deleted 90 days after the decision. The decision itself is kept.</li>
			<li>Your account: until you delete it. Deleting removes your name, phone number, photo, profiles and verification files, and ends every session. Records other people depend on (for example messages you sent, or an anonymised entry in the audit log) remain without your details.</li>
			<li>Backups are kept for up to 30 days.</li>
		</ul>
		<h2>Security</h2>
		<p>Identity documents are encrypted. We store only a fingerprint of your sign-in sessions, strip hidden data from photos, and never show a property's exact location publicly.</p>
		<h2>Your rights</h2>
		<p>Under the Data Protection Act you can ask for a copy of your data, ask us to correct it, object to how we use it, or ask us to delete it. You can also complain to the Data Protection Commission of Ghana.</p>
		<p>
			To use these rights, write to us:
			@contact(v)
		</p>
		<h2>Cookies</h2>
		<p>We use only the cookies RentMap needs to work: your sign-in, your theme and data-saver choices, and saved places when you're not signed in. No advertising or tracking cookies.</p>
	}
}

// Offline is what the service worker shows when a page can't load. It's
// cached for everyone, so it must never contain anything about the viewer:
// Base only, no header.
templ Offline() {
	@layouts.Base(layouts.Meta{Title: "You're offline", NoIndex: true}) {
		<main id="main" class="grid min-h-dvh place-items-center px-4">
			<div class="max-w-sm text-center">
				<img src={ reqctx.Asset(ctx, "img/icon-192.png") } alt="" width="64" height="64" class="mx-auto size-16"/>
				<h1 class="mt-6 text-2xl font-semibold tracking-tight text-fg">You're offline</h1>
				<p class="mt-2 text-fg-muted">RentMap needs a connection to show places. Check your data or Wi-Fi, then try again.</p>
				<a href="" class="mt-6 inline-flex h-11 items-center rounded-lg bg-primary px-5 font-medium text-on-primary">Try again</a>
			</div>
		</main>
	}
}
