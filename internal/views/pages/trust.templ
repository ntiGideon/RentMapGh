package pages

import (
	c "rentmapgh/internal/views/components"
	"rentmapgh/internal/views/layouts"
)

// ── Report a listing ─────────────────────────────────────────────────────

type ReportListingView struct {
	ListingID, Headline, Reason, Note string
	Reasons                           []Opt
	Done                              bool
	Errors                            map[string]string
}

templ ReportListing(m layouts.Meta, v ReportListingView) {
	@layouts.Site(m) {
		<div class="mx-auto max-w-xl px-4 pb-24 pt-8 sm:px-6">
			<a href={ templ.SafeURL("/l/" + v.ListingID) } class="inline-flex items-center gap-1 text-sm text-fg-muted hover:text-fg">
				@c.Icon("chevron-left", "size-4")
				Back to the listing
			</a>
			if v.Done {
				<div class="mt-8">
					@c.EmptyState("shield-check", "Thanks for telling us", "Our team reviews every report, usually within a day. If you were asked for money, don't pay — and report the messages too.") {
						@c.LinkButton("/search", c.Ghost, c.MD) {
							Back to the map
						}
					}
				</div>
			} else {
				<h1 class="mt-3 text-2xl font-semibold tracking-tight text-fg">Report this listing</h1>
				<p class="mt-1 text-base text-fg-muted">{ v.Headline }</p>
				<form method="post" action={ templ.SafeURL("/l/" + v.ListingID + "/report") } class="mt-6 space-y-5">
					<fieldset>
						<legend class="text-sm font-semibold text-fg">What's wrong?</legend>
						if msg := v.Errors["reason"]; msg != "" {
							<p class="mt-1 text-sm text-danger" role="alert">{ msg }</p>
						}
						<div class="mt-3 space-y-2">
							for _, r := range v.Reasons {
								<label class="flex cursor-pointer items-center gap-3 rounded-lg border border-line px-3 py-2.5 text-sm text-fg hover:bg-surface has-checked:border-graphite-900 dark:has-checked:border-mint-200">
									<input type="radio" name="reason" value={ r.Value } checked?={ r.Value == v.Reason } required class="size-4 accent-graphite-900 dark:accent-mint-200"/>
									{ r.Label }
								</label>
							}
						</div>
					</fieldset>
					@c.Textarea(c.TextareaProps{ID: "note", Name: "note", Label: "Anything else we should know?", Value: v.Note, Rows: 3, MaxLen: 500})
					<div class="flex justify-end">
						@c.Button(c.ButtonProps{Type: "submit", Variant: c.DangerSoft}) {
							Send report
						}
					</div>
				</form>
			}
		</div>
	}
}

// ── Viewing feedback ─────────────────────────────────────────────────────

type FeedbackView struct {
	ViewingID, Headline, When, Lister string
	Done                              bool
	Errors                            map[string]string
}

templ Feedback(m layouts.Meta, v FeedbackView) {
	@layouts.Site(m) {
		<div class="mx-auto max-w-xl px-4 pb-24 pt-8 sm:px-6">
			<a href={ templ.SafeURL("/viewings/" + v.ViewingID) } class="inline-flex items-center gap-1 text-sm text-fg-muted hover:text-fg">
				@c.Icon("chevron-left", "size-4")
				The viewing
			</a>
			if v.Done {
				<div class="mt-8">
					@c.EmptyState("check", "Thanks for the feedback", "It helps other renters know which listings are accurate and which listers show up.") {
						@c.LinkButton("/search", c.Ghost, c.MD) {
							Keep looking
						}
					}
				</div>
			} else {
				<h1 class="mt-3 text-2xl font-semibold tracking-tight text-fg">How was the viewing?</h1>
				<p class="mt-1 text-base text-fg-muted">{ v.Headline } · { v.When }</p>
				if msg := v.Errors["form"]; msg != "" {
					<div class="mt-4">
						@alert(msg)
					</div>
				}
				<form method="post" action={ templ.SafeURL("/viewings/" + v.ViewingID + "/feedback") } class="mt-6 space-y-6">
					@choice("outcome", "Did the viewing happen?", v.Errors["outcome"], []Opt{
						{"happened", "Yes, I saw the place"},
						{"renter_missed", "No, I couldn't go"},
						{"lister_missed", "No, " + v.Lister + " didn't show up"},
					})
					@choice("accuracy", "Was it as described?", v.Errors["accuracy"], []Opt{
						{"as_described", "Yes, as described"},
						{"mostly", "Mostly"},
						{"not_as_described", "No — the photos, price or details were wrong"},
					})
					@choice("interested", "Are you interested in renting it?", "", []Opt{{"yes", "Yes"}, {"no", "No"}})
					@c.Textarea(c.TextareaProps{ID: "note", Name: "note", Label: "Anything else?", Rows: 3, MaxLen: 500,
						Hint: "Only RentMap sees this. It isn't shown on the listing."})
					<div class="flex justify-end">
						@c.Button(c.ButtonProps{Type: "submit"}) {
							Send feedback
						}
					</div>
				</form>
			}
		</div>
	}
}

templ choice(name, legend, errMsg string, opts []Opt) {
	<fieldset>
		<legend class="text-sm font-semibold text-fg">{ legend }</legend>
		if errMsg != "" {
			<p class="mt-1 text-sm text-danger" role="alert">{ errMsg }</p>
		}
		<div class="mt-2 flex flex-wrap gap-2">
			for _, o := range opts {
				<label class="inline-flex cursor-pointer items-center rounded-lg border border-line px-3 py-2 text-sm text-fg hover:bg-surface has-checked:border-graphite-900 has-checked:bg-graphite-900 has-checked:text-white dark:has-checked:border-mint-200 dark:has-checked:bg-mint-200 dark:has-checked:text-graphite-900">
					<input type="radio" name={ name } value={ o.Value } class="sr-only"/>
					{ o.Label }
				</label>
			}
		</div>
	</fieldset>
}

// ── Notification centre ──────────────────────────────────────────────────

type NotificationRow struct {
	Title, Body, URL, When string
	Unread                 bool
}

type NotificationsView struct{ Rows []NotificationRow }

templ Notifications(m layouts.Meta, v NotificationsView) {
	@layouts.Site(m) {
		<div class="mx-auto max-w-2xl px-4 pb-24 pt-8 sm:px-6">
			<div class="flex flex-wrap items-end justify-between gap-2">
				<h1 class="text-2xl font-semibold tracking-tight text-fg">Notifications</h1>
				<a href="/account#notifications" class="text-sm font-medium text-link">SMS settings</a>
			</div>
			if len(v.Rows) == 0 {
				<div class="mt-10">
					@c.EmptyState("check", "You're all caught up", "Viewing requests, confirmations and reminders will show up here.") {
					}
				</div>
			} else {
				<ul class="mt-6 divide-y divide-line rounded-card border border-line bg-surface-raised">
					for _, n := range v.Rows {
						<li>
							<a href={ templ.SafeURL(n.URL) } class="flex items-start gap-3 px-4 py-3 hover:bg-surface">
								<span class={ "mt-1.5 size-2 shrink-0 rounded-full", templ.KV("bg-graphite-900 dark:bg-mint-200", n.Unread), templ.KV("bg-transparent", !n.Unread) } aria-hidden="true"></span>
								<span class="min-w-0 flex-1">
									<span class={ "block text-sm text-fg", templ.KV("font-semibold", n.Unread) }>{ n.Title }</span>
									if n.Body != "" {
										<span class="block text-sm text-fg-muted">{ n.Body }</span>
									}
								</span>
								<span class="shrink-0 text-xs tabular-nums text-fg-subtle">{ n.When }</span>
							</a>
						</li>
					}
				</ul>
			}
		</div>
	}
}
