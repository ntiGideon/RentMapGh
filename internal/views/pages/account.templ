package pages

import "rentmapgh/internal/views/layouts"

templ Onboarding(form templ.Component) {
	@layouts.Focused(layouts.Meta{Title: "Welcome", Path: "/onboarding", NoIndex: true}, "max-w-md") {
		@form
	}
}

templ Account(greeting string, body templ.Component) {
	@layouts.Site(layouts.Meta{Title: "Account", Path: "/account", NoIndex: true}) {
		<div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
			<div class="mb-10">
				<p class="text-sm text-fg-muted">{ greeting }</p>
				<h1 class="mt-1 text-2xl font-semibold text-fg sm:text-3xl">Your account</h1>
			</div>
			@body
		</div>
	}
}

// Verify wraps an identity/licence step in the focused layout.
templ Verify(title string, step templ.Component) {
	@layouts.Focused(layouts.Meta{Title: title, NoIndex: true}, "max-w-lg") {
		@step
	}
}

templ AccountDelete(body templ.Component) {
	@layouts.Focused(layouts.Meta{Title: "Delete account", NoIndex: true}, "max-w-md") {
		@body
	}
}
