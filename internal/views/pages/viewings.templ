package pages

import (
	c "rentmapgh/internal/views/components"
	"rentmapgh/internal/views/layouts"
)

// Opt is a value + label.
type Opt struct{ Value, Label string }

// ── Booking form ─────────────────────────────────────────────────────────

type Slot struct{ Value, Label string }

type SlotDay struct {
	Label string
	Slots []Slot
}

type ViewingRequestView struct {
	ListingID, Headline, Area, Cover, ListingURL string
	Fee                                          string // "" = free
	HasHours                                     bool
	Days                                         []SlotDay
	Picked                                       string
	MinDate, MaxDate                             string
	Times                                        []string
	Note                                         string
	FeeAck                                       bool
	Errors                                       map[string]string
}

templ ViewingRequest(m layouts.Meta, v ViewingRequestView) {
	@layouts.Site(m) {
		<div class="mx-auto max-w-2xl px-4 pb-24 pt-8 sm:px-6">
			<a href={ templ.SafeURL(v.ListingURL) } class="inline-flex items-center gap-1 text-sm text-fg-muted hover:text-fg">
				@c.Icon("chevron-left", "size-4")
				Back to the listing
			</a>
			<h1 class="mt-3 text-2xl font-semibold tracking-tight text-fg">Book a viewing</h1>
			@listingChip(v.Cover, v.Headline, v.Area)
			<form method="post" action={ templ.SafeURL("/l/" + v.ListingID + "/viewing") } class="mt-6 space-y-7">
				if msg := v.Errors["form"]; msg != "" {
					@alert(msg)
				}
				<fieldset>
					<legend class="text-base font-semibold text-fg">
						if v.HasHours {
							Pick a time
						} else {
							Suggest a time
						}
					</legend>
					if msg := v.Errors["starts_at"]; msg != "" {
						<p class="mt-1 text-sm text-danger dark:text-red-300" role="alert">{ msg }</p>
					}
					if v.HasHours {
						if len(v.Days) == 0 {
							<p class="mt-2 text-sm text-fg-muted">No free viewing times in the next two weeks. Check back soon, or save the place for later.</p>
						}
						<div class="mt-3 space-y-4">
							for _, d := range v.Days {
								<div>
									<p class="text-sm font-medium text-fg-muted">{ d.Label }</p>
									<div class="mt-2 flex flex-wrap gap-2">
										for _, s := range d.Slots {
											<label class="inline-flex h-10 cursor-pointer items-center rounded-lg border border-line px-3.5 text-sm tabular-nums text-fg hover:bg-surface has-checked:border-graphite-900 has-checked:bg-graphite-900 has-checked:text-white dark:has-checked:border-mint-200 dark:has-checked:bg-mint-200 dark:has-checked:text-graphite-900">
												<input type="radio" name="starts_at" value={ s.Value } checked?={ s.Value == v.Picked } required class="sr-only"/>
												{ s.Label }
											</label>
										}
									</div>
								</div>
							}
						</div>
					} else {
						<p class="mt-1 text-sm text-fg-muted">The lister hasn't set viewing hours, so suggest a day and time. They can accept or propose another.</p>
						@dateTime(v.MinDate, v.MaxDate, v.Times)
					}
				</fieldset>
				if v.Fee != "" {
					<div class="rounded-lg border border-amber-500/30 bg-amber-50 p-4 dark:bg-amber-400/10">
						<p class="text-sm font-semibold text-amber-900 dark:text-amber-200">Viewing fee: { v.Fee }</p>
						<p class="mt-1 text-sm text-amber-900/80 dark:text-amber-100/80">Paid in person at the viewing, only after you've met the lister. Never send money before.</p>
						<label class="mt-3 flex items-center gap-2 text-sm font-medium text-amber-900 dark:text-amber-100">
							<input type="checkbox" name="fee_ack" value="1" checked?={ v.FeeAck } class="size-4 accent-graphite-900"/>
							I understand there's a { v.Fee } viewing fee
						</label>
						if msg := v.Errors["fee_ack"]; msg != "" {
							<p class="mt-1 text-sm text-danger" role="alert">{ msg }</p>
						}
					</div>
				}
				@c.Textarea(c.TextareaProps{ID: "note", Name: "note", Label: "Message to the lister", Value: v.Note, Rows: 3, MaxLen: 300, Error: v.Errors["note"],
					Placeholder: "Who's coming, when you'd like to move in, questions…", Hint: "Don't share payment details. RentMap never asks you to pay to book."})
				<div class="flex items-center justify-end gap-3 border-t border-line pt-5">
					@c.Button(c.ButtonProps{Type: "submit"}) {
						Send request
					}
				</div>
			</form>
		</div>
	}
}

templ dateTime(minDate, maxDate string, times []string) {
	<div class="mt-3 grid grid-cols-2 gap-3 sm:max-w-sm">
		<label class="block">
			<span class="text-xs text-fg-muted">Day</span>
			<input type="date" name="date" min={ minDate } max={ maxDate } required class="mt-1 h-10 w-full rounded-lg border border-line bg-surface-raised px-3 text-sm text-fg"/>
		</label>
		<label class="block">
			<span class="text-xs text-fg-muted">Time</span>
			<select name="time" required class="mt-1 h-10 w-full rounded-lg border border-line bg-surface-raised px-3 text-sm text-fg">
				for _, t := range times {
					<option value={ t } selected?={ t == "10:00" }>{ t }</option>
				}
			</select>
		</label>
	</div>
}

templ listingChip(cover, headline, area string) {
	<div class="mt-4 flex items-center gap-3 rounded-lg border border-line bg-surface-raised p-2.5">
		if cover != "" {
			<img src={ cover } alt="" class="size-14 shrink-0 rounded-md object-cover"/>
		} else {
			<span class="grid size-14 shrink-0 place-items-center rounded-md bg-surface text-fg-subtle">
				@c.Icon("home", "size-5")
			</span>
		}
		<div class="min-w-0">
			<p class="truncate text-sm font-semibold text-fg">{ headline }</p>
			<p class="truncate text-sm text-fg-muted">{ area }</p>
		</div>
	</div>
}

templ alert(msg string) {
	<div class="flex items-center gap-2 rounded-lg border border-red-600/15 bg-red-50 px-3 py-2.5 text-sm text-danger dark:bg-red-400/10 dark:text-red-300" role="alert">
		@c.Icon("alert", "size-3.5")
		{ msg }
	</div>
}

// ── One viewing ──────────────────────────────────────────────────────────

type ViewingDetailView struct {
	ID, Role, Status, StatusLabel      string
	Headline, Area, ListingURL, Cover  string
	When, Duration, Note, Fee          string
	Upcoming, Unlocked                 bool
	RenterName, ListerName             string
	DeclineReason                      string
	Reasons                            []Opt
	MinDate, MaxDate                   string
	Times                              []string
	Address, Coords, GoogleURL, WazeURL string
	OtherPhone, OtherTel, OtherWhatsApp string
	Notice                             string
	Errors                             map[string]string
}

func (v ViewingDetailView) other() string {
	if v.Role == "lister" {
		return v.RenterName
	}
	return v.ListerName
}

func (v ViewingDetailView) act(a string) string { return "/viewings/" + v.ID + "/" + a }

func statusTone(s string) c.Tone {
	switch s {
	case "confirmed", "completed":
		return c.Success
	case "requested", "proposed":
		return c.Warning
	}
	return c.Neutral
}

templ ViewingDetail(m layouts.Meta, v ViewingDetailView) {
	@layouts.Site(m) {
		<div class="mx-auto max-w-2xl px-4 pb-24 pt-8 sm:px-6">
			<a href="/viewings" class="inline-flex items-center gap-1 text-sm text-fg-muted hover:text-fg">
				@c.Icon("chevron-left", "size-4")
				All viewings
			</a>
			<div class="mt-3 flex flex-wrap items-center justify-between gap-2">
				<h1 class="text-2xl font-semibold tracking-tight text-fg">Viewing</h1>
				@c.Badge(statusTone(v.Status)) {
					{ v.StatusLabel }
				}
			</div>
			<a href={ templ.SafeURL(v.ListingURL) } class="block">
				@listingChip(v.Cover, v.Headline, v.Area)
			</a>
			if v.Notice != "" {
				<p class="mt-4 rounded-lg border border-line bg-surface px-3 py-2.5 text-sm text-fg" role="status">{ v.Notice }</p>
			}
			if msg := v.Errors["form"]; msg != "" {
				<div class="mt-4">
					@alert(msg)
				</div>
			}
			<dl class="mt-6 grid grid-cols-2 gap-4 rounded-card border border-line bg-surface-raised p-5 text-sm">
				<div class="col-span-2">
					<dt class="text-fg-muted">
						if v.Status == "proposed" {
							Suggested time
						} else {
							When
						}
					</dt>
					<dd class="mt-0.5 text-lg font-semibold tabular-nums text-fg">{ v.When } <span class="text-sm font-normal text-fg-muted">· { v.Duration }</span></dd>
				</div>
				<div>
					<dt class="text-fg-muted">
						if v.Role == "lister" {
							Renter
						} else {
							Lister
						}
					</dt>
					<dd class="mt-0.5 font-medium text-fg">{ v.other() }</dd>
				</div>
				<div>
					<dt class="text-fg-muted">Viewing fee</dt>
					<dd class="mt-0.5 font-medium text-fg">
						if v.Fee != "" {
							{ v.Fee }, paid at the viewing
						} else {
							Free
						}
					</dd>
				</div>
				if v.Note != "" {
					<div class="col-span-2">
						<dt class="text-fg-muted">Message</dt>
						<dd class="mt-0.5 whitespace-pre-line text-fg">{ v.Note }</dd>
					</div>
				}
				if v.DeclineReason != "" && v.Status == "declined" {
					<div class="col-span-2">
						<dt class="text-fg-muted">Reason</dt>
						<dd class="mt-0.5 text-fg">{ v.DeclineReason }</dd>
					</div>
				}
			</dl>
			if v.Unlocked {
				@unlocked(v)
			} else if v.Role == "renter" && (v.Status == "requested" || v.Status == "proposed") {
				<p class="mt-4 flex items-start gap-2 text-sm text-fg-muted">
					@c.Icon("map-pin", "mt-0.5 size-4 shrink-0")
					The exact address and the lister's phone number appear here once the viewing is confirmed.
				</p>
			}
			@actions(v)
		</div>
	}
}

templ unlocked(v ViewingDetailView) {
	<section class="mt-6 overflow-hidden rounded-card border border-green-600/20 bg-green-50/60 dark:bg-green-400/5" aria-labelledby="where-h">
		<div class="p-5">
			<h2 id="where-h" class="flex items-center gap-2 text-base font-semibold text-fg">
				@c.Icon("map-pin", "size-4 text-success dark:text-green-300")
				if v.Role == "renter" {
					Where to go
				} else {
					Confirmed
				}
			</h2>
			if v.Role == "renter" {
				<p class="mt-2 text-base text-fg">{ v.Address }</p>
				if v.Coords != "" {
					<div class="mt-3 flex flex-wrap gap-2">
						<a href={ templ.SafeURL(v.GoogleURL) } target="_blank" rel="noopener" class="inline-flex h-10 items-center gap-1.5 rounded-lg bg-primary px-3.5 text-sm font-medium text-on-primary shadow-btn">
							@c.Icon("map", "size-4")
							Navigate with Google Maps
						</a>
						<a href={ templ.SafeURL(v.WazeURL) } target="_blank" rel="noopener" class="inline-flex h-10 items-center rounded-lg border border-line bg-surface-raised px-3.5 text-sm font-medium text-fg shadow-xs">Waze</a>
					</div>
				}
			}
			if v.OtherPhone != "" {
				<div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
					<span class="text-fg-muted">{ v.other() }:</span>
					<a href={ templ.SafeURL(v.OtherTel) } class="font-semibold tabular-nums text-fg underline-offset-4 hover:underline">{ v.OtherPhone }</a>
					<a href={ templ.SafeURL(v.OtherWhatsApp) } target="_blank" rel="noopener" class="inline-flex h-8 items-center gap-1 rounded-lg border border-line bg-surface-raised px-2.5 font-medium text-fg">
						@c.Icon("message", "size-3.5")
						WhatsApp
					</a>
				</div>
			}
			<a href={ templ.SafeURL("/viewings/" + v.ID + "/calendar.ics") } class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-link">
				@c.Icon("calendar-check", "size-4")
				Add to calendar
			</a>
		</div>
		<p class="border-t border-green-600/15 px-5 py-3 text-xs text-fg-muted">Meet in daylight, take someone with you, and never pay rent or fees before you've seen the place and met the owner or agent.</p>
	</section>
}

templ actions(v ViewingDetailView) {
	<div class="mt-6 space-y-4">
		if v.Role == "lister" && v.Status == "requested" && v.Upcoming {
			<form method="post" action={ templ.SafeURL(v.act("accept")) }>
				@c.Button(c.ButtonProps{Type: "submit", Full: true}) {
					Accept { v.When }
				}
			</form>
		}
		if v.Role == "renter" && v.Status == "proposed" && v.Upcoming {
			<form method="post" action={ templ.SafeURL(v.act("accept-proposal")) }>
				@c.Button(c.ButtonProps{Type: "submit", Full: true}) {
					Accept { v.When }
				}
			</form>
		}
		if v.Role == "lister" && (v.Status == "requested" || v.Status == "proposed") {
			<details class="group rounded-card border border-line bg-surface-raised">
				<summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium text-fg">
					Suggest another time
					@c.Icon("chevron-right", "size-4 transition-transform group-open:rotate-90")
				</summary>
				<form method="post" action={ templ.SafeURL(v.act("propose")) } class="border-t border-line px-4 pb-4 pt-1">
					if msg := v.Errors["starts_at"]; msg != "" {
						<p class="mt-2 text-sm text-danger" role="alert">{ msg }</p>
					}
					@dateTime(v.MinDate, v.MaxDate, v.Times)
					<div class="mt-3 flex justify-end">
						@c.Button(c.ButtonProps{Type: "submit", Variant: c.Ghost}) {
							Send new time
						}
					</div>
				</form>
			</details>
			<details class="group rounded-card border border-line bg-surface-raised">
				<summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium text-fg">
					Decline
					@c.Icon("chevron-right", "size-4 transition-transform group-open:rotate-90")
				</summary>
				<form method="post" action={ templ.SafeURL(v.act("decline")) } class="space-y-3 border-t border-line px-4 pb-4 pt-3">
					<select name="reason" class="h-10 w-full rounded-lg border border-line bg-surface-raised px-3 text-sm text-fg">
						for _, r := range v.Reasons {
							<option value={ r.Value }>{ r.Label }</option>
						}
					</select>
					<div class="flex justify-end">
						@c.Button(c.ButtonProps{Type: "submit", Variant: c.DangerSoft}) {
							Decline request
						}
					</div>
				</form>
			</details>
		}
		if v.Role == "lister" && v.Status == "confirmed" && !v.Upcoming {
			<div class="flex gap-2">
				<form method="post" action={ templ.SafeURL(v.act("done")) } class="flex-1">
					@c.Button(c.ButtonProps{Type: "submit", Full: true}) {
						The viewing happened
					}
				</form>
				<form method="post" action={ templ.SafeURL(v.act("no-show")) } class="flex-1">
					@c.Button(c.ButtonProps{Type: "submit", Variant: c.Ghost, Full: true}) {
						They didn't come
					}
				</form>
			</div>
		}
		if v.Upcoming && (v.Status == "requested" || v.Status == "proposed" || v.Status == "confirmed") && !(v.Role == "lister" && v.Status != "confirmed") {
			<form method="post" action={ templ.SafeURL(v.act("cancel")) } class="text-center">
				<button type="submit" class="text-sm font-medium text-fg-muted underline-offset-4 hover:text-danger hover:underline">
					if v.Status == "requested" {
						Cancel request
					} else {
						Cancel viewing
					}
				</button>
			</form>
		}
	</div>
}

// ── Lists ────────────────────────────────────────────────────────────────

type ViewingRow struct {
	URL, Headline, Area, When, Status, StatusLabel, With, Cover string
	Past, NeedsYou                                              bool
}

type ViewingListView struct {
	Mine, Theirs []ViewingRow
	IsLister     bool
	Hours        string
}

templ ViewingList(m layouts.Meta, v ViewingListView) {
	@layouts.Site(m) {
		<div class="mx-auto max-w-3xl px-4 pb-24 pt-8 sm:px-6">
			<h1 class="text-2xl font-semibold tracking-tight text-fg">Viewings</h1>
			if v.IsLister {
				<section class="mt-8">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<h2 class="text-base font-semibold text-fg">Requests for your places</h2>
						<a href="/viewings/hours" class="text-sm font-medium text-link">
							if v.Hours != "" {
								Hours: { v.Hours }
							} else {
								Set your viewing hours
							}
						</a>
					</div>
					@viewingRows(v.Theirs, "No requests yet. Renters book from your listing pages.")
				</section>
			}
			<section class="mt-8">
				<h2 class="text-base font-semibold text-fg">
					if v.IsLister {
						Places you're viewing
					} else {
						Your viewings
					}
				</h2>
				@viewingRows(v.Mine, "You haven't booked any viewings yet.")
			</section>
		</div>
	}
}

templ viewingRows(rows []ViewingRow, empty string) {
	if len(rows) == 0 {
		<p class="mt-3 rounded-card border border-dashed border-line-strong px-4 py-6 text-center text-sm text-fg-muted">{ empty }</p>
	} else {
		<ul class="mt-3 divide-y divide-line rounded-card border border-line bg-surface-raised">
			for _, r := range rows {
				<li>
					<a href={ templ.SafeURL(r.URL) } class={ "flex items-center gap-3 px-3 py-3 hover:bg-surface", templ.KV("opacity-60", r.Past) }>
						if r.Cover != "" {
							<img src={ r.Cover } alt="" class="size-12 shrink-0 rounded-md object-cover"/>
						} else {
							<span class="grid size-12 shrink-0 place-items-center rounded-md bg-surface text-fg-subtle">
								@c.Icon("home", "size-4")
							</span>
						}
						<div class="min-w-0 flex-1">
							<p class="truncate text-sm font-semibold text-fg">{ r.Headline }</p>
							<p class="truncate text-sm tabular-nums text-fg-muted">{ r.When } · { r.With }</p>
						</div>
						if r.NeedsYou {
							@c.Badge(c.Warning) {
								Needs your answer
							}
						} else {
							@c.Badge(statusTone(r.Status)) {
								{ r.StatusLabel }
							}
						}
					</a>
				</li>
			}
		</ul>
	}
}

// ── Hours ────────────────────────────────────────────────────────────────

type HoursDay struct {
	Day, Name, From, To string
	On                  bool
}

type ViewingHoursView struct {
	Days  []HoursDay
	Times []string
	Saved bool
}

templ ViewingHours(m layouts.Meta, v ViewingHoursView) {
	@layouts.Site(m) {
		<div class="mx-auto max-w-xl px-4 pb-24 pt-8 sm:px-6">
			<a href="/viewings" class="inline-flex items-center gap-1 text-sm text-fg-muted hover:text-fg">
				@c.Icon("chevron-left", "size-4")
				Viewings
			</a>
			<h1 class="mt-3 text-2xl font-semibold tracking-tight text-fg">Viewing hours</h1>
			<p class="mt-1 text-base text-fg-muted">When can renters come and see your places? They pick a 30-minute slot in these hours; you still accept each one.</p>
			if v.Saved {
				<p class="mt-4 rounded-lg border border-line bg-surface px-3 py-2.5 text-sm text-fg" role="status">Saved. Renters now see these times.</p>
			}
			<form method="post" action="/viewings/hours" class="mt-6">
				<ul class="divide-y divide-line rounded-card border border-line bg-surface-raised">
					for _, d := range v.Days {
						<li class="flex flex-wrap items-center gap-3 px-4 py-3">
							<label class="flex w-32 items-center gap-2 text-sm font-medium text-fg">
								<input type="checkbox" name={ "day_" + d.Day } value="1" checked?={ d.On } class="size-4 accent-graphite-900 dark:accent-mint-200"/>
								{ d.Name }
							</label>
							@clockSelect("from_"+d.Day, d.From, v.Times, "From")
							<span class="text-sm text-fg-muted">to</span>
							@clockSelect("to_"+d.Day, d.To, v.Times, "To")
						</li>
					}
				</ul>
				<div class="mt-5 flex justify-end">
					@c.Button(c.ButtonProps{Type: "submit"}) {
						Save hours
					}
				</div>
			</form>
		</div>
	}
}

templ clockSelect(name, value string, times []string, label string) {
	<select name={ name } aria-label={ label } class="h-9 rounded-lg border border-line bg-surface-raised px-2 text-sm tabular-nums text-fg">
		for _, t := range times {
			<option value={ t } selected?={ t == value }>{ t }</option>
		}
	</select>
}
