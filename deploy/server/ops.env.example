# /etc/rentmap/ops.env on the server (mode 600, owner deploy): settings for
# the cron jobs. deploy/monitor/betterstack.sh prints the HEARTBEAT_* lines.
HEARTBEAT_PITR_BACKUP=
HEARTBEAT_DUMP_BACKUP=
HEARTBEAT_PITR_CHECK=
HEARTBEAT_RESTORE_TEST=
HEARTBEAT_PITR_TEST=
HEARTBEAT_HOST_CHECK=

# Off-site copy of the nightly pg_dump + volumes (rclone remote:bucket,
# configured as the deploy user with `rclone config`). Empty = local only.
RCLONE_REMOTE=
KEEP_DAYS=30
DISK_ALERT_PCT=80
