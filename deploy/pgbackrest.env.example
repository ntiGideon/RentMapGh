# Copy to deploy/.env.pgbackrest (not committed) to add an off-site,
# encrypted pgBackRest repository. Leave the file out and only the local
# repo1 (the pgbackrest volume on the same server) is used.
#
# Cloudflare R2: create a bucket (e.g. rentmap-pitr) and an API token with
# Object Read & Write on it.
PGBACKREST_REPO2_TYPE=s3
PGBACKREST_REPO2_PATH=/pgbackrest
PGBACKREST_REPO2_S3_BUCKET=rentmap-pitr
PGBACKREST_REPO2_S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
PGBACKREST_REPO2_S3_REGION=auto
PGBACKREST_REPO2_S3_URI_STYLE=path
PGBACKREST_REPO2_S3_KEY=<access-key-id>
PGBACKREST_REPO2_S3_KEY_SECRET=<secret-access-key>
PGBACKREST_REPO2_RETENTION_FULL_TYPE=time
PGBACKREST_REPO2_RETENTION_FULL=23
# Encrypts everything written to R2. `openssl rand -base64 48`; keep a copy
# in the password manager with DOCUMENT_KEY — the repo is unreadable without it.
PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO2_CIPHER_PASS=<long-random-passphrase>
