{
	# Cloudflare sits in front: trust its edge IPs for the client address.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# The app sets its own security headers; hide server fingerprinting.
	header -Server

	reverse_proxy web:8080 {
		# chi's RealIP middleware reads X-Real-IP.
		header_up X-Real-IP {client_ip}
		health_uri /healthz
		health_interval 10s
	}

	log {
		output stdout
		format json
	}
}
