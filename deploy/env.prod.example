# deploy/.env.prod on the server (mode 600, never committed). provision.sh
# copies this template there; fill every <…>. Secrets: `openssl rand -base64 48`.
# Keep AUTH_SECRET, LOCATION_SECRET and DOCUMENT_KEY in the team password
# manager: a restore is useless without them.

BASE_URL=https://<domain>
SITE_ADDRESS=<domain>          # Caddy gets the certificate for this name
POSTGRES_PASSWORD=<openssl rand -base64 32 | tr -d '/+='>

AUTH_SECRET=<openssl rand -base64 48>
LOCATION_SECRET=<openssl rand -base64 48>   # NEVER rotate: it fixes every map pin's offset
DOCUMENT_KEY=<openssl rand -base64 32>      # decrypts ID evidence; lose it and the uploads are gone

# SMS (Africa's Talking, live account; the sender ID must be approved)
SMS_PROVIDER=africastalking
SMS_SENDER_ID=RentMap
AT_USERNAME=<username>
AT_API_KEY=<api key>
AT_SANDBOX=false

SUPPORT_EMAIL=support@<domain>
SENTRY_DSN=                    # optional: https://<key>@<org>.ingest.sentry.io/<project>

# Listing photos: on the media volume (disk, the default) or in R2.
MEDIA_STORE=disk
# MEDIA_STORE=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=rentmap-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# WEB_IMAGE and RELEASE are set by deploy/server/deploy.sh in deploy/.env.release.
